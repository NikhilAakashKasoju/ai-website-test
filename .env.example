# Copy to .env.local for local development, or set these in Render's dashboard.
# Both are OPTIONAL — the site builds and runs correctly without them.
#
# NOTE: NEXT_PUBLIC_* variables are inlined at BUILD time, not read at runtime.
# Changing one in Render requires a redeploy for it to take effect.

# External enrollment / checkout page.
# Falls back to the URL hardcoded in src/lib/data.ts when unset.
NEXT_PUBLIC_REGISTER_URL=

# Your final public origin, e.g. https://learn.edufulness.com
# Used to build absolute URLs for social share previews.
NEXT_PUBLIC_SITE_URL=
